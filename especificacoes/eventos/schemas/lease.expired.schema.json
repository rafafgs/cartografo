{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lease.expired.schema.json",
  "title": "lease.expired",
  "description": "A posse caducou e o trabalho volta para a fila (D5). Extensão do cartografo, sem equivalente no flowpilot.",
  "type": "object",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "lease.expired"
    },
    "entity": {
      "type": "object",
      "properties": {
        "type": {
          "const": "lease"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "runner_id",
        "reason"
      ],
      "properties": {
        "runner_id": {
          "type": "string",
          "description": "Runner que perdeu a posse."
        },
        "reason": {
          "enum": [
            "heartbeat_lost",
            "ttl_elapsed"
          ],
          "description": "heartbeat_perdido: o runner parou de dar sinal antes do prazo. expirou: o prazo chegou ao fim sem renovação."
        }
      },
      "additionalProperties": false
    }
  }
}
