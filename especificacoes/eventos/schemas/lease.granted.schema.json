{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lease.granted.schema.json",
  "title": "lease.granted",
  "description": "Um runner tomou posse de um trabalho por um prazo (D5). Extensão do cartografo: o flowpilot é de um runner só e não tem equivalente.",
  "type": "object",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "lease.granted"
    },
    "entity": {
      "type": "object",
      "properties": {
        "type": {
          "const": "lease"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "job_id",
        "runner_id",
        "expires_at"
      ],
      "properties": {
        "job_id": {
          "type": "integer",
          "description": "Trabalho despachado sob esta posse."
        },
        "runner_id": {
          "type": "string",
          "description": "Runner que tomou a posse."
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Quando a posse caduca se o heartbeat não a renovar."
        }
      },
      "additionalProperties": false
    }
  }
}
