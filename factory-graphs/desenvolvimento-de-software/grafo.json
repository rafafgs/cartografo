{
  "problem_class": "desenvolvimento-de-software",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "Software delivery — the flowpilot flow, ported",
    "description": "Factory graph 1 (D14): the flowpilot flow expressed in this format. One node per activity state; flowpilot's queue states (to_refine, to_develop, to_integrate, to_test, to_deploy) do not become nodes — they are the controller's scheduling plumbing, not the topology of the work. The edges follow ALLOWED_TRANSITIONS with those queues collapsed, including the test → develop rework cycle.",
    "schema_version": "1.0.0",
    "created_at": "2026-08-14",
    "source": "manual port of flowpilot (D17: behavioural reference, with no code dependency)"
  },
  "nodes": [
    {
      "id": "refine",
      "role": "architect",
      "node_type": "work",
      "description": "Turns the request into a specification: functional requirements, touched files, acceptance criteria and negative scope.",
      "skill_ref": {
        "id": "refine-ticket",
        "version": "1.0.1",
        "hash": "sha256:79667013229d5e5095c0eef985ef6759e154d444fcb247c9c25aa0181c37d735"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "request"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "request": {
              "type": "string",
              "minLength": 1
            },
            "project_profile": {
              "type": "string"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "specification",
            "acceptance_criteria",
            "touched_files",
            "note"
          ],
          "properties": {
            "specification": {
              "type": "string",
              "minLength": 1
            },
            "acceptance_criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "touched_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "out_of_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "model_tier": {
              "type": "string",
              "enum": [
                "standard",
                "strong"
              ],
              "description": "the model strength the work asks for; never a model and never a named vendor"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "one line with what the session decided and every default it took; it is what makes a default reviewable"
            },
            "gotchas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "produces": "ticket",
        "checks": [
          {
            "type": "agentic",
            "instruction": "Is every acceptance criterion verifiable by a concrete test, and does the list of touched files exist in the repository? Attach the verified path of each file cited.",
            "required_evidence": true,
            "description": "An unverifiable acceptance criterion is refinement's most expensive defect: it contaminates every step that follows."
          }
        ]
      }
    },
    {
      "id": "develop",
      "role": "developer",
      "node_type": "work",
      "description": "Implements the specification in an isolated checkout, with the acceptance tests written before the implementation.",
      "skill_ref": {
        "id": "develop-ticket",
        "version": "1.0.1",
        "hash": "sha256:646ea312c75ceb326ab0a153abcec7d8bf8b0d7a7ddc8ed3bd6975468d215410"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "specification",
            "acceptance_criteria"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "specification": {
              "type": "string",
              "minLength": 1
            },
            "acceptance_criteria": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "branch",
            "commits"
          ],
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "commits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "unexpected_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "produces": "artifact",
        "checks": [
          {
            "type": "deterministic",
            "command": "{{input.project.test_command}}",
            "description": "The project's suite passes in the work's isolated checkout."
          },
          {
            "type": "deterministic",
            "command": "{{input.project.quality_commands}}",
            "description": "Every quality command the profile declares, and not only the ones the session thinks it touched."
          },
          {
            "type": "deterministic",
            "command": "git diff --quiet && git diff --cached --quiet",
            "description": "Nothing was left out of the commit: the next node only sees the branch."
          },
          {
            "type": "agentic",
            "instruction": "Were the acceptance tests committed before the implementation, and do they cover the criteria of the specification? Attach the hashes of both commits and the diff of the tests commit.",
            "required_evidence": true,
            "description": "Verifies the TDD order by the history, not by the report of whoever developed it."
          }
        ]
      }
    },
    {
      "id": "integrate",
      "role": "integrator",
      "node_type": "work",
      "description": "Brings the branch onto the main line and reverifies the suite against the already integrated tree.",
      "skill_ref": {
        "id": "integrate-branch",
        "version": "1.0.1",
        "hash": "sha256:e5d9a64ccfc7c278dc2ed3fd7a457774c0636af14d76795cafd8d23f29315910"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "branch"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "merge_commit"
          ],
          "properties": {
            "merge_commit": {
              "type": "string",
              "minLength": 1
            },
            "resolved_conflicts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "produces": "artifact",
        "checks": [
          {
            "type": "deterministic",
            "command": "{{input.project.test_command}}",
            "description": "The suite passes on the merged tree, not only on the isolated branch."
          },
          {
            "type": "deterministic",
            "command": "{{input.project.quality_commands}}",
            "description": "The flow's last deterministic station: the test gate reruns none of it."
          },
          {
            "type": "deterministic",
            "command": "git diff --quiet && git diff --cached --quiet",
            "description": "No leftovers of a half-finished merge hidden in the tree."
          }
        ]
      }
    },
    {
      "id": "test",
      "role": "tester",
      "node_type": "gate",
      "description": "Exercises the delivered behaviour against the acceptance criteria and routes: approved moves on to deployment, rework goes back to development.",
      "skill_ref": {
        "id": "alpha-test",
        "version": "1.0.5",
        "hash": "sha256:18be65c9f7c13ff831fb01bf53d29233a38268dc304f89ea56f1b9eb37cc5ba6"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "acceptance_criteria",
            "merge_commit"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "acceptance_criteria": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "merge_commit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "resultado",
            "outcome",
            "verdicts"
          ],
          "properties": {
            "resultado": {
              "type": "string",
              "enum": [
                "approved",
                "rework"
              ],
              "description": "The edge this gate takes, and the reserved key of the report protocol: one fenced block carries the report and the label together, and this is the label (`packages/runner/src/dispatch/parse-node-result.ts`). The KEY is the protocol's and is spelled the way the runner and the control plane reserve it; the VALUES are THIS graph's — the `condition` of an edge leaving `test` — which is why the label is declared here and never in the pinned skill's `output`: the control plane takes it out of the report before holding the rest against that schema (t269, `docs/spec/graph.md`), and the same skill under another graph would carry other labels. Escalation is not among them: it pauses the node with an input-request instead of opening a third edge."
            },
            "outcome": {
              "enum": [
                "approved",
                "rework",
                "escalate"
              ]
            },
            "verdicts": {
              "type": "array",
              "minItems": 1,
              "description": "one per acceptance criterion, with the evidence THIS gate produced; a criterion that was not exercised gets an honest entry, never a skipped one",
              "items": {
                "type": "object",
                "required": [
                  "ref",
                  "verdict",
                  "evidence"
                ],
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "verdict": {
                    "enum": [
                      "passed",
                      "failed",
                      "not_exercised"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "bugs": {
              "type": "array",
              "description": "what the walkthrough found; the severity is what lets the executor schedule the fix",
              "items": {
                "type": "object",
                "required": [
                  "severity",
                  "title",
                  "criterion",
                  "repro"
                ],
                "properties": {
                  "severity": {
                    "enum": [
                      "simple",
                      "complex"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "criterion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repro": {
                    "type": "string",
                    "minLength": 1
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "checks": [
          {
            "type": "agentic",
            "instruction": "Run the delivered behaviour and check each acceptance criterion against the real application. Attach the output of every run; the developer's report does not count as evidence.",
            "required_evidence": true,
            "description": "An agentic gate verifies with evidence of its own (learning note, 2026-08-14)."
          }
        ]
      }
    },
    {
      "id": "deploy",
      "role": "deployer",
      "node_type": "work",
      "description": "Publishes what was approved and closes the traversal.",
      "skill_ref": {
        "id": "verify-release",
        "version": "1.0.1",
        "hash": "sha256:4ba085f8f429356305c3b0ed5e76f010493deeefd587b095418aca5569a4efe4"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "merge_commit"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "merge_commit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "release",
            "deployed_at"
          ],
          "properties": {
            "release": {
              "type": "string",
              "minLength": 1
            },
            "deployed_at": {
              "type": "string"
            }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "git -C {{input.project.repo}} rev-parse --verify --quiet {{input.referencia.commit}}^{commit}",
            "description": "The reference exists as a commit: without it, \"does not contain\" would be indistinguishable from \"I do not know\"."
          },
          {
            "type": "deterministic",
            "command": "git -C {{input.project.repo}} merge-base --is-ancestor {{input.artifact.merge_commit}} {{input.referencia.commit}}",
            "description": "The whole question of the step: the work's merge commit is an ancestor of the published reference."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "refine",
      "to": "develop",
      "condition": "always",
      "description": "flowpilot: refining -> to_develop -> developing."
    },
    {
      "from": "develop",
      "to": "integrate",
      "condition": "always",
      "description": "flowpilot: developing -> to_integrate -> integrating."
    },
    {
      "from": "integrate",
      "to": "test",
      "condition": "always",
      "description": "flowpilot: integrating -> to_test -> testing."
    },
    {
      "from": "test",
      "to": "deploy",
      "condition": "approved",
      "description": "flowpilot: testing -> to_deploy -> deploying."
    },
    {
      "from": "test",
      "to": "develop",
      "condition": "rework",
      "description": "flowpilot: testing -> to_develop, the alpha test's rework cycle."
    }
  ],
  "initial_node": "refine",
  "final_nodes": [
    "deploy"
  ],
  "custom_fields": [],
  "project": {
    "repo": ".",
    "main_branch": "main",
    "test_command": "npm test",
    "install_command": "npm ci",
    "quality_commands": [
      "npm test",
      "npm run lint",
      "npm run typecheck"
    ],
    "conventions": "Contract-first: every capability — skill, gate, node — declares its input and output in JSON Schema plus a list of typed verifications (D9). Single writer: only the control plane writes to the database, and the runner is a client of the public API like any other (D1, D11). Append-only persistence with git-like versioning inside the database; rollback moves a pointer and nothing is ever deleted (D2, D15). Everything is written in English — code, identifiers, format keys, and the content that reaches a person or a model alike (D18, as amended on 2026-08-18).",
    "ledger_files": [
      "DECISIONS.md",
      "packages/core/migrations",
      "schema",
      "specs"
    ],
    "application": {
      "running": false,
      "address": "none; see absence_reason",
      "absence_reason": "no orchestration for bringing an application up exists in this v0; validate whatever the checkout allows"
    }
  }
}
