              "type": "string",
              "minLength": 1
            },
            "commits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "arquivos_inesperados": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "verificacoes": [
          {
            "tipo": "deterministico",
            "comando": "make check",
            "descricao": "Suíte, lint e typecheck verdes no branch da ticket."
          },
          {
            "tipo": "agentico",
            "instrucao": "Os testes de aceite foram commitados antes da implementação e cobrem os critérios da especificação? Anexe os hashes dos dois commits e o diff do commit de testes.",
            "evidencia_obrigatoria": true,
            "descricao": "Verifica a ordem do TDD pelo histórico, não pelo relato de quem desenvolveu."
          }
        ]
      }
    },
