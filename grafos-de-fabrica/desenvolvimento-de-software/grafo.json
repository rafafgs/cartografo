        "verificacoes": [
          {
            "tipo": "deterministico",
            "comando": "make check",
            "descricao": "Reverificação determinística antes de qualquer julgamento."
          },
          {
            "tipo": "agentico",
            "instrucao": "Rode o comportamento entregue e confira cada critério de aceite na aplicação real. Anexe a saída de cada execução; relato do desenvolvedor não conta como evidência.",
            "evidencia_obrigatoria": true,
            "descricao": "Portão agêntico verifica com evidência própria (nota de aprendizado, 2026-08-14)."
          }
        ]
      }
