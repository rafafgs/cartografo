{
  "problem_class": "desenvolvimento-de-software",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "Entrega de software — fluxo do flowpilot portado",
    "description": "Grafo de fábrica 1 (D14): o fluxo do flowpilot expresso neste formato. Um nó por estado de atividade; os estados de fila do flowpilot (to_refine, to_develop, to_integrate, to_test, to_deploy) não viram nó — são plumbing de escalonamento do controller, não topologia do trabalho. As arestas seguem ALLOWED_TRANSITIONS colapsando essas filas, incluindo o ciclo de retrabalho testar → desenvolver.",
    "schema_version": "1.0.0",
    "created_at": "2026-08-14",
    "source": "porte manual do flowpilot (D17: referência de comportamento, sem dependência de código)"
  },
  "nodes": [
    {
      "id": "refinar",
      "role": "arquiteto",
      "node_type": "work",
      "description": "Transforma o pedido em especificação: requisitos funcionais, arquivos tocados, critérios de aceite e escopo negativo.",
      "skill_ref": {
        "id": "refinar-ticket",
        "version": "1.0.0",
        "hash": "sha256:92e6b2ad13c2ab9c6c0c8ea5addee5e2aced0336bbe3c5d906b702f5f85e8562"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "pedido"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "pedido": {
              "type": "string",
              "minLength": 1
            },
            "perfil_do_projeto": {
              "type": "string"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "especificacao",
            "criterios_de_aceite",
            "arquivos_tocados",
            "nota"
          ],
          "properties": {
            "especificacao": {
              "type": "string",
              "minLength": 1
            },
            "criterios_de_aceite": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "arquivos_tocados": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fora_de_escopo": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tier_modelo": {
              "type": "string",
              "enum": [
                "padrao",
                "forte"
              ],
              "description": "força de modelo que o trabalho pede; nunca um modelo nem um fornecedor nomeado"
            },
            "nota": {
              "type": "string",
              "minLength": 1,
              "description": "uma linha com o que a sessão decidiu e todo default que tomou; é o que torna um default revisável"
            },
            "gotchas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "produces": "ticket",
        "checks": [
          {
            "type": "agentic",
            "instruction": "Cada critério de aceite é verificável por um teste concreto, e a lista de arquivos tocados existe no repositório? Anexe o caminho conferido de cada arquivo citado.",
            "required_evidence": true,
            "description": "Critério de aceite não verificável é o defeito mais caro do refino: contamina todas as etapas seguintes."
          }
        ]
      }
    },
    {
      "id": "desenvolver",
      "role": "desenvolvedor",
      "node_type": "work",
      "description": "Implementa a especificação em checkout isolado, com os testes de aceite escritos antes da implementação.",
      "skill_ref": {
        "id": "desenvolver-ticket",
        "version": "1.0.0",
        "hash": "sha256:b2504dbfd708a13ae72350c32b80232e0836aba7c76922c704f8dd1127fa0581"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "especificacao",
            "criterios_de_aceite"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "especificacao": {
              "type": "string",
              "minLength": 1
            },
            "criterios_de_aceite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "branch",
            "commits"
          ],
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "commits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "arquivos_inesperados": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "produces": "artefato",
        "checks": [
          {
            "type": "deterministic",
            "command": "{{input.project.comando_testes}}",
            "description": "A suíte do projeto passa no checkout isolado do trabalho."
          },
          {
            "type": "deterministic",
            "command": "{{input.project.comandos_qualidade}}",
            "description": "Todo comando de qualidade que o perfil declara, e não só o que a sessão acha que tocou."
          },
          {
            "type": "deterministic",
            "command": "git diff --quiet && git diff --cached --quiet",
            "description": "Nada ficou fora do commit: o nó seguinte só enxerga o branch."
          },
          {
            "type": "agentic",
            "instruction": "Os testes de aceite foram commitados antes da implementação e cobrem os critérios da especificação? Anexe os hashes dos dois commits e o diff do commit de testes.",
            "required_evidence": true,
            "description": "Verifica a ordem do TDD pelo histórico, não pelo relato de quem desenvolveu."
          }
        ]
      }
    },
    {
      "id": "integrar",
      "role": "integrador",
      "node_type": "work",
      "description": "Traz o branch para a linha principal e reverifica a suíte contra a árvore já integrada.",
      "skill_ref": {
        "id": "integrar-branch",
        "version": "1.0.0",
        "hash": "sha256:7e0d21744b205bb0509d642840812c34e1f9264f1c8c4ad7a43504a8810c87d0"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "branch"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "merge_commit"
          ],
          "properties": {
            "merge_commit": {
              "type": "string",
              "minLength": 1
            },
            "conflitos_resolvidos": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "produces": "artefato",
        "checks": [
          {
            "type": "deterministic",
            "command": "{{input.project.comando_testes}}",
            "description": "A suíte passa na árvore mesclada, não só no branch isolado."
          },
          {
            "type": "deterministic",
            "command": "{{input.project.comandos_qualidade}}",
            "description": "Última estação determinística do fluxo: o portão de teste não reroda nada disto."
          },
          {
            "type": "deterministic",
            "command": "git diff --quiet && git diff --cached --quiet",
            "description": "Nenhuma sobra de merge pela metade escondida na árvore."
          }
        ]
      }
    },
    {
      "id": "testar",
      "role": "tester",
      "node_type": "gate",
      "description": "Exercita o comportamento entregue contra os critérios de aceite e roteia: aprovado segue para implantação, retrabalho volta para desenvolvimento.",
      "skill_ref": {
        "id": "testar-alpha",
        "version": "1.0.3",
        "hash": "sha256:536789d6720e2cc4464287d16937ff0c921c7f6f3912a12566072fe904fe76be"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "criterios_de_aceite",
            "merge_commit"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "criterios_de_aceite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "merge_commit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "outcome",
            "vereditos"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "aprovado",
                "retrabalho",
                "escala"
              ]
            },
            "vereditos": {
              "type": "array",
              "minItems": 1,
              "description": "um por critério de aceite, com a evidência que ESTE portão produziu; critério não exercitado tem entrada honesta, nunca é pulado",
              "items": {
                "type": "object",
                "required": [
                  "ref",
                  "veredito",
                  "evidencia"
                ],
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "veredito": {
                    "enum": [
                      "passou",
                      "falhou",
                      "nao_exercitado"
                    ]
                  },
                  "evidencia": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "bugs": {
              "type": "array",
              "description": "o que a caminhada encontrou; a severidade é o que deixa o executor agendar o conserto",
              "items": {
                "type": "object",
                "required": [
                  "severidade",
                  "titulo",
                  "criterio",
                  "repro"
                ],
                "properties": {
                  "severidade": {
                    "enum": [
                      "simples",
                      "complexo"
                    ]
                  },
                  "titulo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "criterio": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repro": {
                    "type": "string",
                    "minLength": 1
                  },
                  "arquivos": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "checks": [
          {
            "type": "agentic",
            "instruction": "Rode o comportamento entregue e confira cada critério de aceite na aplicação real. Anexe a saída de cada execução; relato do desenvolvedor não conta como evidência.",
            "required_evidence": true,
            "description": "Portão agêntico verifica com evidência própria (nota de aprendizado, 2026-08-14)."
          }
        ]
      }
    },
    {
      "id": "implantar",
      "role": "deployer",
      "node_type": "work",
      "description": "Publica o que foi aprovado e encerra a travessia.",
      "skill_ref": {
        "id": "implantar-release",
        "version": "1.0.0",
        "hash": "sha256:aec5b3230e4317f0369540952af25a0f29a011316513a79162a1a70fad7afde8"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "merge_commit"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "merge_commit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "release",
            "implantado_em"
          ],
          "properties": {
            "release": {
              "type": "string",
              "minLength": 1
            },
            "implantado_em": {
              "type": "string"
            }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "git -C {{input.project.repo}} rev-parse --verify --quiet {{input.referencia.commit}}^{commit}",
            "description": "A referência existe como commit: sem isso, \"não contém\" seria indistinguível de \"não sei\"."
          },
          {
            "type": "deterministic",
            "command": "git -C {{input.project.repo}} merge-base --is-ancestor {{input.artefato.merge_commit}} {{input.referencia.commit}}",
            "description": "A pergunta inteira da etapa: o merge commit do trabalho é ancestral da referência publicada."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "refinar",
      "to": "desenvolver",
      "condition": "sempre",
      "description": "flowpilot: refining -> to_develop -> developing."
    },
    {
      "from": "desenvolver",
      "to": "integrar",
      "condition": "sempre",
      "description": "flowpilot: developing -> to_integrate -> integrating."
    },
    {
      "from": "integrar",
      "to": "testar",
      "condition": "sempre",
      "description": "flowpilot: integrating -> to_test -> testing."
    },
    {
      "from": "testar",
      "to": "implantar",
      "condition": "aprovado",
      "description": "flowpilot: testing -> to_deploy -> deploying."
    },
    {
      "from": "testar",
      "to": "desenvolver",
      "condition": "retrabalho",
      "description": "flowpilot: testing -> to_develop, o ciclo de retrabalho do teste alfa."
    }
  ],
  "initial_node": "refinar",
  "final_nodes": [
    "implantar"
  ],
  "custom_fields": [],
  "project": {
    "repo": ".",
    "branch_principal": "main",
    "comando_testes": "npm test",
    "comandos_qualidade": [
      "npm test",
      "npm run lint",
      "npm run typecheck"
    ],
    "convencoes": "Contract-first: toda capacidade — skill, portão, nó — declara entrada e saída em JSON Schema mais uma lista de verificações tipadas (D9). Escritor único: só o control plane escreve no banco, e o runner é cliente da API pública como qualquer outro (D1, D11). Persistência append-only com versionamento tipo git dentro do banco; rollback move ponteiro e nada é apagado (D2, D15). Código, identificadores e chaves de formato em inglês; conteúdo que chega a uma pessoa ou a um modelo em português (D18).",
    "arquivos_de_registro": [
      "DECISOES.md",
      "packages/core/migrations",
      "schema",
      "especificacoes"
    ],
    "aplicacao": {
      "rodando": false,
      "endereco": "nenhum; ver motivo_ausencia",
      "motivo_ausencia": "nenhuma orquestracao de subida de aplicacao existe neste v0; valide o que o checkout permitir"
    }
  }
}
