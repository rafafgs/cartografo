  "metadata": {
    "nome": "Entrega de software — fluxo do flowpilot portado",
    "descricao": "Grafo de fábrica 1 (D14): o fluxo do flowpilot expresso neste formato. Um nó por estado de atividade; os estados de fila do flowpilot (to_refine, to_develop, to_integrate, to_test, to_deploy) não viram nó — são plumbing de escalonamento do controller, não topologia do trabalho. As arestas seguem ALLOWED_TRANSITIONS colapsando essas filas, incluindo o ciclo de retrabalho testar → desenvolver.",
    "versao_schema": "1.0.0",
    "criado_em": "2026-08-14",
    "origem": "porte manual do flowpilot (D17: referência de comportamento, sem dependência de código)"
  },
  "nos": [
    {
      "id": "refinar",
      "papel": "arquiteto",
      "tipo_no": "trabalho",
      "descricao": "Transforma o pedido em especificação: requisitos funcionais, arquivos tocados, critérios de aceite e escopo negativo.",
      "skill_ref": {
        "id": "refinar-ticket",
        "versao": "1.0.0",
        "hash": "sha256:2af61665b994e6a73fe02779e33dedc3c37a4f14c5d0546fa92ea6ad33b01249"
      },
      "contrato": {
        "entrada_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "pedido"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "pedido": {
              "type": "string",
              "minLength": 1
            },
            "perfil_do_projeto": {
              "type": "string"
            }
          }
        },
        "saida_schema": {
          "type": "object",
          "required": [
            "especificacao",
            "criterios_de_aceite",
            "arquivos_tocados"
          ],
          "properties": {
            "especificacao": {
              "type": "string",
              "minLength": 1
            },
            "criterios_de_aceite": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "arquivos_tocados": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fora_de_escopo": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "verificacoes": [
          {
            "tipo": "agentico",
            "instrucao": "Cada critério de aceite é verificável por um teste concreto, e a lista de arquivos tocados existe no repositório? Anexe o caminho conferido de cada arquivo citado.",
            "evidencia_obrigatoria": true,
            "descricao": "Critério de aceite não verificável é o defeito mais caro do refino: contamina todas as etapas seguintes."
          }
        ]
      }
    },
    {
      "id": "desenvolver",
