{
  "classe": "desenvolvimento-de-software",
  "linhagem": {
    "tipo": "base"
  },
  "metadata": {
    "nome": "Entrega de software — fluxo do flowpilot portado",
    "descricao": "Grafo de fábrica 1 (D14): o fluxo do flowpilot expresso neste formato. Um nó por estado de atividade; os estados de fila do flowpilot (to_refine, to_develop, to_integrate, to_test, to_deploy) não viram nó — são plumbing de escalonamento do controller, não topologia do trabalho. As arestas seguem ALLOWED_TRANSITIONS colapsando essas filas, incluindo o ciclo de retrabalho testar → desenvolver.",
    "versao_schema": "1.0.0",
    "criado_em": "2026-08-14",
    "origem": "porte manual do flowpilot (D17: referência de comportamento, sem dependência de código)"
  },
  "nos": [
    {
      "id": "refinar",
      "papel": "arquiteto",
      "tipo_no": "trabalho",
      "descricao": "Transforma o pedido em especificação: requisitos funcionais, arquivos tocados, critérios de aceite e escopo negativo.",
      "skill_ref": {
        "id": "refinar-ticket",
        "versao": "1.0.0",
        "hash": "sha256:598262e114039af85da7109cd3bd4f0e6a28a76d21b3d62c7d7b58ba7afbb9c1"
      },
      "contrato": {
        "entrada_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "pedido"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "pedido": {
              "type": "string",
              "minLength": 1
            },
            "perfil_do_projeto": {
              "type": "string"
            }
          }
        },
        "saida_schema": {
          "type": "object",
          "required": [
            "especificacao",
            "criterios_de_aceite",
            "arquivos_tocados",
            "nota"
          ],
          "properties": {
            "especificacao": {
              "type": "string",
              "minLength": 1
            },
            "criterios_de_aceite": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "arquivos_tocados": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fora_de_escopo": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tier_modelo": {
              "type": "string",
              "enum": [
                "padrao",
                "forte"
              ],
              "description": "força de modelo que o trabalho pede; nunca um modelo nem um fornecedor nomeado"
            },
            "nota": {
              "type": "string",
              "minLength": 1,
              "description": "uma linha com o que a sessão decidiu e todo default que tomou; é o que torna um default revisável"
            },
            "gotchas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "verificacoes": [
          {
            "tipo": "agentico",
            "instrucao": "Cada critério de aceite é verificável por um teste concreto, e a lista de arquivos tocados existe no repositório? Anexe o caminho conferido de cada arquivo citado.",
            "evidencia_obrigatoria": true,
            "descricao": "Critério de aceite não verificável é o defeito mais caro do refino: contamina todas as etapas seguintes."
          }
        ]
      }
    },
    {
      "id": "desenvolver",
      "papel": "desenvolvedor",
      "tipo_no": "trabalho",
      "descricao": "Implementa a especificação em checkout isolado, com os testes de aceite escritos antes da implementação.",
      "skill_ref": {
        "id": "desenvolver-ticket",
        "versao": "1.0.0",
        "hash": "sha256:fa92367d51a5d15bae71700e9c895796280b2b35c6fab174771c31e96f7e2f87"
      },
      "contrato": {
        "entrada_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "especificacao",
            "criterios_de_aceite"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "especificacao": {
              "type": "string",
              "minLength": 1
            },
            "criterios_de_aceite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "saida_schema": {
          "type": "object",
          "required": [
            "branch",
            "commits"
          ],
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "commits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "arquivos_inesperados": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "verificacoes": [
          {
            "tipo": "deterministico",
            "comando": "{{entrada.projeto.comando_testes}}",
            "descricao": "A suíte do projeto passa no checkout isolado do trabalho."
          },
          {
            "tipo": "deterministico",
            "comando": "{{entrada.projeto.comandos_qualidade}}",
            "descricao": "Todo comando de qualidade que o perfil declara, e não só o que a sessão acha que tocou."
          },
          {
            "tipo": "deterministico",
            "comando": "git diff --quiet && git diff --cached --quiet",
            "descricao": "Nada ficou fora do commit: o nó seguinte só enxerga o branch."
          },
          {
            "tipo": "agentico",
            "instrucao": "Os testes de aceite foram commitados antes da implementação e cobrem os critérios da especificação? Anexe os hashes dos dois commits e o diff do commit de testes.",
            "evidencia_obrigatoria": true,
            "descricao": "Verifica a ordem do TDD pelo histórico, não pelo relato de quem desenvolveu."
          }
        ]
      }
    },
    {
      "id": "integrar",
      "papel": "integrador",
      "tipo_no": "trabalho",
      "descricao": "Traz o branch para a linha principal e reverifica a suíte contra a árvore já integrada.",
      "skill_ref": {
        "id": "integrar-branch",
        "versao": "1.0.0",
        "hash": "sha256:982955800480ed9856b7a174ac172cf04b697a6c621ab05af6396163bd5a9906"
      },
      "contrato": {
        "entrada_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "branch"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "saida_schema": {
          "type": "object",
          "required": [
            "merge_commit"
          ],
          "properties": {
            "merge_commit": {
              "type": "string",
              "minLength": 1
            },
            "conflitos_resolvidos": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "verificacoes": [
          {
            "tipo": "deterministico",
            "comando": "{{entrada.projeto.comando_testes}}",
            "descricao": "A suíte passa na árvore mesclada, não só no branch isolado."
          },
          {
            "tipo": "deterministico",
            "comando": "{{entrada.projeto.comandos_qualidade}}",
            "descricao": "Última estação determinística do fluxo: o portão de teste não reroda nada disto."
          },
          {
            "tipo": "deterministico",
            "comando": "git diff --quiet && git diff --cached --quiet",
            "descricao": "Nenhuma sobra de merge pela metade escondida na árvore."
          }
        ]
      }
    },
    {
      "id": "testar",
      "papel": "tester",
      "tipo_no": "portao",
      "descricao": "Exercita o comportamento entregue contra os critérios de aceite e roteia: aprovado segue para implantação, retrabalho volta para desenvolvimento.",
      "skill_ref": {
        "id": "testar-alpha",
        "versao": "1.0.0",
        "hash": "sha256:1321f33d031629d6463ea7c1e179ba1ac58b1e528804f81ab8ba71b317d71067"
      },
      "contrato": {
        "entrada_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "criterios_de_aceite",
            "merge_commit"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "criterios_de_aceite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "merge_commit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "saida_schema": {
          "type": "object",
          "required": [
            "resultado",
            "vereditos"
          ],
          "properties": {
            "resultado": {
              "enum": [
                "aprovado",
                "retrabalho",
                "escala"
              ]
            },
            "vereditos": {
              "type": "array",
              "minItems": 1,
              "description": "um por critério de aceite, com a evidência que ESTE portão produziu; critério não exercitado tem entrada honesta, nunca é pulado",
              "items": {
                "type": "object",
                "required": [
                  "ref",
                  "veredito",
                  "evidencia"
                ],
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "veredito": {
                    "enum": [
                      "passou",
                      "falhou",
                      "nao_exercitado"
                    ]
                  },
                  "evidencia": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "bugs": {
              "type": "array",
              "description": "o que a caminhada encontrou; a severidade é o que deixa o executor agendar o conserto",
              "items": {
                "type": "object",
                "required": [
                  "severidade",
                  "titulo",
                  "criterio",
                  "repro"
                ],
                "properties": {
                  "severidade": {
                    "enum": [
                      "simples",
                      "complexo"
                    ]
                  },
                  "titulo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "criterio": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repro": {
                    "type": "string",
                    "minLength": 1
                  },
                  "arquivos": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "verificacoes": [
          {
            "tipo": "agentico",
            "instrucao": "Rode o comportamento entregue e confira cada critério de aceite na aplicação real. Anexe a saída de cada execução; relato do desenvolvedor não conta como evidência.",
            "evidencia_obrigatoria": true,
            "descricao": "Portão agêntico verifica com evidência própria (nota de aprendizado, 2026-08-14)."
          }
        ]
      }
    },
    {
      "id": "implantar",
      "papel": "deployer",
      "tipo_no": "trabalho",
      "descricao": "Publica o que foi aprovado e encerra a travessia.",
      "skill_ref": {
        "id": "implantar-release",
        "versao": "1.0.0",
        "hash": "sha256:d1bd047f6a995691d4a441477ef890db76533ead673c9e742b5a275635b9ff40"
      },
      "contrato": {
        "entrada_schema": {
          "type": "object",
          "required": [
            "ticket_id",
            "merge_commit"
          ],
          "properties": {
            "ticket_id": {
              "type": "string",
              "minLength": 1
            },
            "merge_commit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "saida_schema": {
          "type": "object",
          "required": [
            "release",
            "implantado_em"
          ],
          "properties": {
            "release": {
              "type": "string",
              "minLength": 1
            },
            "implantado_em": {
              "type": "string"
            }
          }
        },
        "verificacoes": [
          {
            "tipo": "deterministico",
            "comando": "git -C {{entrada.projeto.repo}} rev-parse --verify --quiet {{entrada.referencia.commit}}^{commit}",
            "descricao": "A referência existe como commit: sem isso, \"não contém\" seria indistinguível de \"não sei\"."
          },
          {
            "tipo": "deterministico",
            "comando": "git -C {{entrada.projeto.repo}} merge-base --is-ancestor {{entrada.artefato.merge_commit}} {{entrada.referencia.commit}}",
            "descricao": "A pergunta inteira da etapa: o merge commit do trabalho é ancestral da referência publicada."
          }
        ]
      }
    }
  ],
  "arestas": [
    {
      "de": "refinar",
      "para": "desenvolver",
      "condicao": "sempre",
      "descricao": "flowpilot: refining -> to_develop -> developing."
    },
    {
      "de": "desenvolver",
      "para": "integrar",
      "condicao": "sempre",
      "descricao": "flowpilot: developing -> to_integrate -> integrating."
    },
    {
      "de": "integrar",
      "para": "testar",
      "condicao": "sempre",
      "descricao": "flowpilot: integrating -> to_test -> testing."
    },
    {
      "de": "testar",
      "para": "implantar",
      "condicao": "aprovado",
      "descricao": "flowpilot: testing -> to_deploy -> deploying."
    },
    {
      "de": "testar",
      "para": "desenvolver",
      "condicao": "retrabalho",
      "descricao": "flowpilot: testing -> to_develop, o ciclo de retrabalho do teste alfa."
    }
  ],
  "no_inicial": "refinar",
  "nos_finais": [
    "implantar"
  ]
}
