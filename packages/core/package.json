{
  "name": "cartografo",
  "version": "0.1.0",
  "description": "The cartografo control plane: sole owner of the embedded SQLite database and of the REST/JSON API (D1, D17).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafafgs/cartografo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/rafafgs/cartografo#readme",
  "bugs": {
    "url": "https://github.com/rafafgs/cartografo/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "cartografo": "./bin/cartografo.mjs",
    "cartografo-runner": "./bin/cartografo-runner.mjs",
    "cartografo-screen": "./bin/cartografo-screen.mjs",
    "cartografo-surveyor": "./bin/cartografo-surveyor.mjs",
    "cost-surveyor": "./bin/cost-surveyor.mjs",
    "cartografo-mcp": "./bin/cartografo-mcp.mjs"
  },
  "files": [
    "bin",
    "migrations",
    "src"
  ],
  "scripts": {
    "prepack": "node ../../scripts/link-bundled-siblings.mjs",
    "start": "node bin/cartografo.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cartografo/cost-surveyor": "^0.1.0",
    "@cartografo/mcp": "^0.1.0",
    "@cartografo/runner": "^0.1.0",
    "@cartografo/screen": "^0.1.0",
    "@cartografo/surveyor": "^0.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "ajv": "^8.17.1",
    "amaro": "^1.1.11",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.0"
  },
  "bundledDependencies": [
    "@cartografo/runner",
    "@cartografo/screen",
    "@cartografo/surveyor",
    "@cartografo/cost-surveyor",
    "@cartografo/mcp"
  ],
  "devDependencies": {
    "@cartografo/test-support": "^0.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "axios": "^1.19.0",
    "openapi-client-axios": "^7.9.0",
    "typescript": "^6.0.3"
  }
}
