    "src"
  ],
  "scripts": {
    "start": "node bin/mcp.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@cartografo/test-support": "^0.1.0",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  }
