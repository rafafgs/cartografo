  "private": true,
  "description": "The cartografo MCP server: one more client of the public API, so a model can read and drive the map through typed tools (D11).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
