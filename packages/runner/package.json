{
  "name": "@cartografo/runner",
  "version": "0.1.0",
  "private": true,
  "description": "Cartografo runner: API client that dispatches CLI sessions through an EngineAdapter (D1, D17).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "cartografo-runner": "./bin/cartografo-runner.mjs"
  },
  "exports": {
    "./surveyor/proposal": {
      "types": "./src/surveyor/proposal.ts",
      "default": "./src/surveyor/proposal.ts"
    },
    "./engine/claude-code-adapter": {
      "types": "./src/engine/claude-code-adapter.ts",
      "default": "./src/engine/claude-code-adapter.ts"
    },
    "./engine/types": {
      "types": "./src/engine/types.ts",
      "default": "./src/engine/types.ts"
    }
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "start": "node bin/cartografo-runner.mjs",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "spike": "node --import tsx scripts/spike-real-session.mjs",
    "spike:codex": "node --import tsx scripts/spike-real-session-codex.mjs",
    "spike:escalation": "node --import tsx scripts/spike-human-escalation.mjs",
    "spike:permissions": "node --import tsx scripts/spike-permission-enforcement.mjs",
    "spike:resume": "node --import tsx scripts/spike-session-resume.mjs",
    "spike:surveyor": "node --import tsx scripts/spike-surveyor-flow.mjs",
    "spike:two-engine": "node --import tsx scripts/spike-two-engine-traversal.mjs",
    "traverse": "node --import tsx scripts/run-graph-traversal.mjs",
    "close-outcome": "node --import tsx scripts/close-surveyor-outcome.mjs",
    "measure-executions": "node --import tsx scripts/measure-executions.mjs",
    "intake": "node --import tsx src/intake/cli.mjs",
    "surveyor": "node --import tsx src/surveyor/cli.mjs",
    "synthesize": "node --import tsx src/synthesizer/cli.mjs",
    "spike:traversal": "node --import tsx scripts/spike-graph-traversal.mjs"
  },
  "dependencies": {
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@cartografo/test-support": "^0.1.0",
    "@types/node": "^24.13.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^6.0.3"
  }
}
