{
  "problem_class": "travessia-automatica",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "Travessia automática — três nós",
    "description": "O menor grafo que exercita as três decisões de avanço de nó da t161: saída única (implementar → conferir), portão com duas saídas rotuladas (conferir → publicar | implementar) e nó final sem saída nenhuma (publicar). O ciclo de retrabalho é deliberado: é o que prova que uma travessia volta atrás sem operador.",
    "schema_version": "1.0.0",
    "created_at": "2026-08-15",
    "source": "fixture da t161"
  },
  "nodes": [
    {
      "id": "implementar",
      "role": "desenvolvedor",
      "node_type": "work",
      "description": "Produz o artefato da travessia.",
      "skill_ref": {
        "id": "travessia-fazer",
        "version": "1.0.0",
        "hash": "sha256:fcf5f11345aa82a2ba823734881114f0e7d4d4908d369de123b353d70440dffb"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["pedido"],
          "properties": {
            "pedido": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["nota"],
          "properties": {
            "nota": { "type": "string", "minLength": 1 }
          }
        },
        "produces": "producao",
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s saida.md",
            "description": "O artefato existe e não está vazio."
          }
        ]
      }
    },
    {
      "id": "conferir",
      "role": "tester",
      "node_type": "gate",
      "description": "Confere o artefato e roteia: aprovado publica, retrabalho volta para implementar.",
      "skill_ref": {
        "id": "travessia-conferir",
        "version": "1.0.0",
        "hash": "sha256:a26c224025323ee4efd18d90c79f48bf64ebf3799f499303206f2088fe2659e3"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["producao"],
          "properties": {
            "producao": {
              "type": "object",
              "required": ["nota"],
              "properties": {
                "nota": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["outcome"],
          "properties": {
            "outcome": { "enum": ["aprovado", "retrabalho"] },
            "evidencia": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "agentic",
            "instruction": "O artefato atende ao que a etapa anterior prometeu? Anexe o trecho que você leu.",
            "required_evidence": true,
            "description": "Portão agêntico confere com evidência própria."
          }
        ]
      }
    },
    {
      "id": "publicar",
      "role": "deployer",
      "node_type": "work",
      "description": "Publica o que foi aprovado e encerra a travessia.",
      "skill_ref": {
        "id": "travessia-fazer",
        "version": "1.0.0",
        "hash": "sha256:fcf5f11345aa82a2ba823734881114f0e7d4d4908d369de123b353d70440dffb"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["nota"],
          "properties": {
            "nota": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["nota"],
          "properties": {
            "nota": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s saida.md",
            "description": "O artefato publicado existe."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "implementar",
      "to": "conferir",
      "condition": "sempre",
      "description": "Saída única: o que foi implementado sempre vai para conferência."
    },
    {
      "from": "conferir",
      "to": "publicar",
      "condition": "aprovado",
      "description": "O portão aprovou: segue para publicação."
    },
    {
      "from": "conferir",
      "to": "implementar",
      "condition": "retrabalho",
      "description": "O portão reprovou: volta para implementação. É o ciclo de retrabalho."
    }
  ],
  "initial_node": "implementar",
  "final_nodes": ["publicar"],
  "custom_fields": [
    {
      "name": "pedido",
      "type": "string",
      "required_at": null,
      "description": "O que a travessia foi pedida para fazer. Campo de classe porque é assim que `travessia-fazer` o lê: escalar plano no topo de `input`, ao lado de `input.job` (t168, t253) — e sem a declaração nenhum nó tem como recebê-lo (t278)."
    }
  ]
}
