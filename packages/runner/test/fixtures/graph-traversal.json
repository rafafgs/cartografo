{
  "problem_class": "travessia-automatica",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "Automatic crossing — three nodes",
    "description": "The smallest graph that exercises t161's three node-advance decisions: a single exit (implementar → conferir), a gate with two labelled exits (conferir → publicar | implementar) and a final node with no exit at all (publicar). The rework cycle is deliberate: it is what proves a crossing can go back without an operator.",
    "schema_version": "1.0.0",
    "created_at": "2026-08-15",
    "source": "t161 fixture"
  },
  "nodes": [
    {
      "id": "implementar",
      "role": "desenvolvedor",
      "node_type": "work",
      "description": "Produces the artifact of the crossing.",
      "skill_ref": {
        "id": "do-crossing",
        "version": "1.0.0",
        "hash": "sha256:4482112308fcfc64cd4754934f6886603ee113254e9ecf4576c34a676a8296b2"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["pedido"],
          "properties": {
            "pedido": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["nota"],
          "properties": {
            "nota": { "type": "string", "minLength": 1 }
          }
        },
        "produces": "producao",
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s saida.md",
            "description": "The artifact exists and is not empty."
          }
        ]
      }
    },
    {
      "id": "conferir",
      "role": "tester",
      "node_type": "gate",
      "description": "Checks the artifact and routes: `aprovado` publishes, `retrabalho` goes back to implementar.",
      "skill_ref": {
        "id": "check-crossing",
        "version": "1.0.0",
        "hash": "sha256:7fff14269033a3ad7569ac0e78e767a457acd28ae2a7fa9c8f628bb4d8608497"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["producao"],
          "properties": {
            "producao": {
              "type": "object",
              "required": ["nota"],
              "properties": {
                "nota": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["outcome"],
          "properties": {
            "outcome": { "enum": ["aprovado", "retrabalho"] },
            "evidencia": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "agentic",
            "instruction": "Does the artifact meet what the previous step promised? Attach the excerpt you read.",
            "required_evidence": true,
            "description": "An agentic gate checks with its own evidence."
          }
        ]
      }
    },
    {
      "id": "publicar",
      "role": "deployer",
      "node_type": "work",
      "description": "Publishes what was approved and closes the crossing.",
      "skill_ref": {
        "id": "do-crossing",
        "version": "1.0.0",
        "hash": "sha256:4482112308fcfc64cd4754934f6886603ee113254e9ecf4576c34a676a8296b2"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["nota"],
          "properties": {
            "nota": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["nota"],
          "properties": {
            "nota": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s saida.md",
            "description": "The published artifact exists."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "implementar",
      "to": "conferir",
      "condition": "sempre",
      "description": "A single exit: whatever was implemented always goes to checking."
    },
    {
      "from": "conferir",
      "to": "publicar",
      "condition": "aprovado",
      "description": "The gate approved: on to publishing."
    },
    {
      "from": "conferir",
      "to": "implementar",
      "condition": "retrabalho",
      "description": "The gate rejected: back to implementation. This is the rework cycle."
    }
  ],
  "initial_node": "implementar",
  "final_nodes": ["publicar"],
  "custom_fields": [
    {
      "name": "pedido",
      "type": "string",
      "required_at": null,
      "description": "What the crossing was asked to do. A class field because that is how `do-crossing` reads it: a flat scalar at the top of `input`, beside `input.job` (t168, t253) — and with no declaration no node has any way of receiving it (t278)."
    }
  ]
}
