{
  "problem_class": "capability-on-subgraph-node",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "A capability on a subgraph node (refused)",
    "description": "The one node is a subgraph node and declares a capability. It pins no skill and opens no session of its own, so there is nothing for the capability to apply to: refused, like engine and model.",
    "schema_version": "1.0.0",
    "created_at": "2026-11-18",
    "source": "a manual port (a counterexample for the capability field)"
  },
  "nodes": [
    {
      "id": "write-note",
      "role": "caller",
      "node_type": "subgraph",
      "description": "Opens a child job of the class nota-curta about the job's own title and collects the finished note.",
      "subgraph": {
        "class": "nota-curta",
        "input_map": {
          "title": "Note about {{input.job.title}}",
          "body": "{{input.job.body}}"
        },
        "output_map": {
          "text": "{{child.texto}}"
        }
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "job"
          ],
          "properties": {
            "job": {
              "type": "object"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "produces": "note",
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s child-output.json",
            "description": "The child job handed back an output."
          }
        ]
      },
      "capability": "advanced"
    }
  ],
  "edges": [],
  "initial_node": "write-note",
  "final_nodes": [
    "write-note"
  ],
  "custom_fields": []
}
