{
  "problem_class": "software-development",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "Software delivery — flowpilot's flow, ported",
    "description": "Factory graph 1 (D14): flowpilot's flow expressed in this format. One node per activity state; flowpilot's queue states (to_refine, to_develop, to_integrate, to_test, to_deploy) do not become nodes — they are the controller's scheduling plumbing, not the topology of the work. The edges follow ALLOWED_TRANSITIONS with those queues collapsed, including the testar → desenvolver rework cycle.",
    "schema_version": "1.0.0",
    "created_at": "2026-08-14",
    "source": "a manual port of flowpilot (D17: a reference of behaviour, with no code dependency)"
  },
  "nodes": [
    {
      "id": "refinar",
      "role": "arquiteto",
      "node_type": "work",
      "description": "Turns the request into a specification: functional requirements, touched files, acceptance criteria and negative scope.",
      "skill_ref": {
        "id": "cartografo/refinar-ticket",
        "version": "1.0.0",
        "hash": "sha256:5daae1dd6b338934e392e122877e9cfb7b998d17d3c5aa5d40107a2c6d35c12f"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["ticket_id", "pedido"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "pedido": { "type": "string", "minLength": 1 },
            "perfil_do_projeto": { "type": "string" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["especificacao", "criterios_de_aceite", "arquivos_tocados"],
          "properties": {
            "especificacao": { "type": "string", "minLength": 1 },
            "criterios_de_aceite": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "arquivos_tocados": { "type": "array", "items": { "type": "string" } },
            "fora_de_escopo": { "type": "array", "items": { "type": "string" } }
          }
        },
        "checks": [
          {
            "type": "agentic",
            "instruction": "Is every acceptance criterion verifiable by a concrete test, and does the list of touched files exist in the repository? Attach the checked path of every file cited.",
            "required_evidence": true,
            "description": "An unverifiable acceptance criterion is refinement's most expensive defect: it contaminates every stage that follows."
          }
        ]
      }
    },
    {
      "id": "desenvolver",
      "role": "desenvolvedor",
      "node_type": "work",
      "description": "Implements the specification in an isolated checkout, with the acceptance tests written before the implementation.",
      "skill_ref": {
        "id": "cartografo/desenvolver-ticket",
        "version": "1.0.0",
        "hash": "sha256:464be2db9d71760fee4b31933cf195fd9b581ec24ab4e0620c5a51cca865ed7e"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["ticket_id", "especificacao", "criterios_de_aceite"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "especificacao": { "type": "string", "minLength": 1 },
            "criterios_de_aceite": { "type": "array", "items": { "type": "string" } }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["branch", "commits"],
          "properties": {
            "branch": { "type": "string", "minLength": 1 },
            "commits": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "arquivos_inesperados": { "type": "array", "items": { "type": "string" } }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "make check",
            "description": "Suite, lint and typecheck green on the ticket's branch."
          },
          {
            "type": "agentic",
            "instruction": "Were the acceptance tests committed before the implementation, and do they cover the specification's criteria? Attach the hashes of both commits and the diff of the test commit.",
            "required_evidence": true,
            "description": "Verifies the TDD order from the history, not from the developer's report."
          }
        ]
      }
    },
    {
      "id": "integrar",
      "role": "integrador",
      "node_type": "work",
      "description": "Brings the branch onto the main line and re-verifies the suite against the already-integrated tree.",
      "skill_ref": {
        "id": "cartografo/integrar-branch",
        "version": "1.0.0",
        "hash": "sha256:a12bea4cd570a45bf0667cdb76bd8c57c8bc949165a30c2e2581472df2030109"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["ticket_id", "branch"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "branch": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["merge_commit"],
          "properties": {
            "merge_commit": { "type": "string", "minLength": 1 },
            "conflitos_resolvidos": { "type": "array", "items": { "type": "string" } }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "make check",
            "description": "The suite passes on the merged tree, not only on the isolated branch."
          }
        ]
      }
    },
    {
      "id": "testar",
      "role": "tester",
      "node_type": "gate",
      "description": "Exercises the delivered behaviour against the acceptance criteria and routes: approved goes on to deployment, rework goes back to development.",
      "skill_ref": {
        "id": "cartografo/testar-alpha",
        "version": "1.0.0",
        "hash": "sha256:5f5184ed32383ec586147bddb5d5aaa1554104efa071ac2fd183d4f0ae87e81c"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["ticket_id", "criterios_de_aceite", "merge_commit"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "criterios_de_aceite": { "type": "array", "items": { "type": "string" } },
            "merge_commit": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["outcome", "evidencia"],
          "properties": {
            "outcome": { "enum": ["aprovado", "retrabalho", "escala"] },
            "evidencia": { "type": "string", "minLength": 1 },
            "defeitos": { "type": "array", "items": { "type": "string" } }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "make check",
            "description": "A deterministic re-verification before any judgement."
          },
          {
            "type": "agentic",
            "instruction": "Run the delivered behaviour and check every acceptance criterion against the real application. Attach the output of every run; the developer's report does not count as evidence.",
            "required_evidence": true,
            "description": "An agentic gate verifies with evidence of its own (the learning note, 2026-08-14)."
          }
        ]
      }
    },
    {
      "id": "implantar",
      "role": "deployer",
      "node_type": "work",
      "description": "Publishes what was approved and closes the traversal.",
      "skill_ref": {
        "id": "cartografo/implantar-release",
        "version": "1.0.0",
        "hash": "sha256:2e4cddb5fdbb1b467d280800299c4150a17022b201eacf7baa56c76e78e01d94"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["ticket_id", "merge_commit"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "merge_commit": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["release", "implantado_em"],
          "properties": {
            "release": { "type": "string", "minLength": 1 },
            "implantado_em": { "type": "string" }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "make smoke",
            "description": "A smoke test against the published environment."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "refinar",
      "to": "desenvolver",
      "condition": "sempre",
      "description": "flowpilot: refining -> to_develop -> developing."
    },
    {
      "from": "desenvolver",
      "to": "integrar",
      "condition": "sempre",
      "description": "flowpilot: developing -> to_integrate -> integrating."
    },
    {
      "from": "integrar",
      "to": "testar",
      "condition": "sempre",
      "description": "flowpilot: integrating -> to_test -> testing."
    },
    {
      "from": "testar",
      "to": "implantar",
      "condition": "aprovado",
      "description": "flowpilot: testing -> to_deploy -> deploying."
    },
    {
      "from": "testar",
      "to": "desenvolver",
      "condition": "retrabalho",
      "description": "flowpilot: testing -> to_develop, the alpha test's rework cycle."
    }
  ],
  "initial_node": "refinar",
  "final_nodes": ["implantar"],
  "custom_fields": []
}
