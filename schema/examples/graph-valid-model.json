{
  "problem_class": "model-selection-proof",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "A model per node in one traversal",
    "description": "Two nodes on one edge: the work one says nothing about a model and falls into the engine's own default, and the gate declares engine \"codex\" and a smaller model. The smallest document that shows t166's use case — asking for a cheaper model at the gate without touching the node that produces.",
    "schema_version": "1.0.0",
    "created_at": "2026-08-16",
    "source": "a manual port (t166's per-node model-selection proof)"
  },
  "nodes": [
    {
      "id": "redigir",
      "role": "redator",
      "node_type": "work",
      "description": "Writes the text. Declares no model: the one that chooses is the engine, with its own default.",
      "skill_ref": {
        "id": "cartografo/redigir-nota",
        "version": "1.0.0",
        "hash": "sha256:2745f9d87a5b35e77dc5a73b8db71039cdfdae5a4c647f2f4122c1f3fb384b18"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["tema"],
          "properties": {
            "tema": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["texto"],
          "properties": {
            "texto": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s nota.md",
            "description": "The note exists and is not empty."
          }
        ]
      }
    },
    {
      "id": "conferir",
      "role": "revisor",
      "node_type": "gate",
      "engine": "codex",
      "model": "gpt-5.6-luna",
      "description": "Checks the text. Declares an engine and a model: checking is cheap work, and does not need the large model that drafted.",
      "skill_ref": {
        "id": "cartografo/revisar-nota",
        "version": "1.0.0",
        "hash": "sha256:2df09e19d5917210efc074a4d3c9d5f4c8e20e29e479f524afdcbbc9859b3e55"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["texto"],
          "properties": {
            "texto": { "type": "string" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["resultado"],
          "properties": {
            "resultado": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s parecer.md",
            "description": "The opinion exists and is not empty."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "redigir",
      "to": "conferir",
      "condition": "sempre",
      "description": "A single exit: the drafted text always goes on to checking."
    }
  ],
  "initial_node": "redigir",
  "final_nodes": ["conferir"],
  "custom_fields": []
}
