{
  "problem_class": "two-engines-proof",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "Two engines in one traversal",
    "description": "Two work nodes on one edge: the first says nothing about an engine and falls into the runner's default, the second declares engine \"codex\". The smallest document that can tell a default from a route (t141).",
    "schema_version": "1.0.0",
    "created_at": "2026-08-15",
    "source": "a manual port (t141's per-node routing proof)"
  },
  "nodes": [
    {
      "id": "redigir",
      "role": "redator",
      "node_type": "work",
      "description": "Writes the text. Declares no engine: the one that runs is the runner's default engine.",
      "skill_ref": {
        "id": "cartografo/redigir-nota",
        "version": "1.0.0",
        "hash": "sha256:2745f9d87a5b35e77dc5a73b8db71039cdfdae5a4c647f2f4122c1f3fb384b18"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["tema"],
          "properties": {
            "tema": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["texto"],
          "properties": {
            "texto": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s nota.md",
            "description": "The note exists and is not empty."
          }
        ]
      }
    },
    {
      "id": "conferir",
      "role": "revisor",
      "node_type": "work",
      "engine": "codex",
      "description": "Checks the text. Declares an engine: this node runs on codex, not on the default.",
      "skill_ref": {
        "id": "cartografo/revisar-nota",
        "version": "1.0.0",
        "hash": "sha256:2df09e19d5917210efc074a4d3c9d5f4c8e20e29e479f524afdcbbc9859b3e55"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["texto"],
          "properties": {
            "texto": { "type": "string" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["parecer"],
          "properties": {
            "parecer": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s parecer.md",
            "description": "The opinion exists and is not empty."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "redigir",
      "to": "conferir",
      "condition": "sempre",
      "description": "A single exit: the drafted text always goes on to checking."
    }
  ],
  "initial_node": "redigir",
  "final_nodes": ["conferir"],
  "custom_fields": []
}
