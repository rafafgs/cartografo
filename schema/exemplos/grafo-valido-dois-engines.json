          "type": "object",
          "required": ["tema"],
          "properties": {
            "tema": { "type": "string", "minLength": 1 }
          }
        },
        "saida_schema": {
          "type": "object",
          "required": ["texto"],
          "properties": {
            "texto": { "type": "string", "minLength": 1 }
          }
        },
        "verificacoes": [
          {
            "tipo": "deterministico",
            "comando": "test -s nota.md",
            "descricao": "A nota existe e não está vazia."
          }
        ]
      }
    },
    {
      "id": "conferir",
      "papel": "revisor",
      "tipo_no": "trabalho",
      "engine": "codex",
      "descricao": "Confere o texto. Declara engine: este nó roda no codex, não no default.",
      "skill_ref": {
        "id": "cartografo/revisar-nota",
        "versao": "1.0.0",
        "hash": "sha256:2df09e19d5917210efc074a4d3c9d5f4c8e20e29e479f524afdcbbc9859b3e55"
      },
      "contrato": {
        "entrada_schema": {
          "type": "object",
          "required": ["texto"],
          "properties": {
            "texto": { "type": "string" }
          }
        },
        "saida_schema": {
          "type": "object",
          "required": ["parecer"],
          "properties": {
            "parecer": { "type": "string", "minLength": 1 }
          }
        },
        "verificacoes": [
          {
            "tipo": "deterministico",
            "comando": "test -s parecer.md",
            "descricao": "O parecer existe e não está vazio."
          }
        ]
      }
    }
