  "metadata": {
    "nome": "Dois engines numa travessia",
    "descricao": "Dois nós de trabalho numa aresta: o primeiro não diz nada sobre engine e cai no default do runner, o segundo declara engine \"codex\". O menor documento que consegue distinguir um default de uma rota (t141).",
    "versao_schema": "1.0.0",
    "criado_em": "2026-08-15",
    "origem": "porte manual (prova de roteamento por nó da t141)"
  },
  "nos": [
    {
      "id": "redigir",
      "papel": "redator",
      "tipo_no": "trabalho",
      "descricao": "Escreve o texto. Não declara engine: quem roda é o engine default do runner.",
      "skill_ref": {
        "id": "cartografo/redigir-nota",
        "versao": "1.0.0",
        "hash": "sha256:2745f9d87a5b35e77dc5a73b8db71039cdfdae5a4c647f2f4122c1f3fb384b18"
      },
      "contrato": {
