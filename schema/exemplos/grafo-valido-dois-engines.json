{
  "problem_class": "prova-dois-engines",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "Dois engines numa travessia",
    "description": "Dois nós de trabalho numa aresta: o primeiro não diz nada sobre engine e cai no default do runner, o segundo declara engine \"codex\". O menor documento que consegue distinguir um default de uma rota (t141).",
    "schema_version": "1.0.0",
    "created_at": "2026-08-15",
    "source": "porte manual (prova de roteamento por nó da t141)"
  },
  "nodes": [
    {
      "id": "redigir",
      "role": "redator",
      "node_type": "work",
      "description": "Escreve o texto. Não declara engine: quem roda é o engine default do runner.",
      "skill_ref": {
        "id": "cartografo/redigir-nota",
        "version": "1.0.0",
        "hash": "sha256:2745f9d87a5b35e77dc5a73b8db71039cdfdae5a4c647f2f4122c1f3fb384b18"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["tema"],
          "properties": {
            "tema": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["texto"],
          "properties": {
            "texto": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s nota.md",
            "description": "A nota existe e não está vazia."
          }
        ]
      }
    },
    {
      "id": "conferir",
      "role": "revisor",
      "node_type": "work",
      "engine": "codex",
      "description": "Confere o texto. Declara engine: este nó roda no codex, não no default.",
      "skill_ref": {
        "id": "cartografo/revisar-nota",
        "version": "1.0.0",
        "hash": "sha256:2df09e19d5917210efc074a4d3c9d5f4c8e20e29e479f524afdcbbc9859b3e55"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["texto"],
          "properties": {
            "texto": { "type": "string" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["parecer"],
          "properties": {
            "parecer": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s parecer.md",
            "description": "O parecer existe e não está vazio."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "redigir",
      "to": "conferir",
      "condition": "sempre",
      "description": "Saída única: o texto redigido sempre segue para conferência."
    }
  ],
  "initial_node": "redigir",
  "final_nodes": ["conferir"]
}
