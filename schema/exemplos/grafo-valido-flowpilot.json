{
  "problem_class": "desenvolvimento-de-software",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "Entrega de software — fluxo do flowpilot portado",
    "description": "Grafo de fábrica 1 (D14): o fluxo do flowpilot expresso neste formato. Um nó por estado de atividade; os estados de fila do flowpilot (to_refine, to_develop, to_integrate, to_test, to_deploy) não viram nó — são plumbing de escalonamento do controller, não topologia do trabalho. As arestas seguem ALLOWED_TRANSITIONS colapsando essas filas, incluindo o ciclo de retrabalho testar → desenvolver.",
    "schema_version": "1.0.0",
    "created_at": "2026-08-14",
    "source": "porte manual do flowpilot (D17: referência de comportamento, sem dependência de código)"
  },
  "nodes": [
    {
      "id": "refinar",
      "role": "arquiteto",
      "node_type": "work",
      "description": "Transforma o pedido em especificação: requisitos funcionais, arquivos tocados, critérios de aceite e escopo negativo.",
      "skill_ref": {
        "id": "cartografo/refinar-ticket",
        "version": "1.0.0",
        "hash": "sha256:5daae1dd6b338934e392e122877e9cfb7b998d17d3c5aa5d40107a2c6d35c12f"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["ticket_id", "pedido"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "pedido": { "type": "string", "minLength": 1 },
            "perfil_do_projeto": { "type": "string" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["especificacao", "criterios_de_aceite", "arquivos_tocados"],
          "properties": {
            "especificacao": { "type": "string", "minLength": 1 },
            "criterios_de_aceite": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "arquivos_tocados": { "type": "array", "items": { "type": "string" } },
            "fora_de_escopo": { "type": "array", "items": { "type": "string" } }
          }
        },
        "checks": [
          {
            "type": "agentic",
            "instruction": "Cada critério de aceite é verificável por um teste concreto, e a lista de arquivos tocados existe no repositório? Anexe o caminho conferido de cada arquivo citado.",
            "required_evidence": true,
            "description": "Critério de aceite não verificável é o defeito mais caro do refino: contamina todas as etapas seguintes."
          }
        ]
      }
    },
    {
      "id": "desenvolver",
      "role": "desenvolvedor",
      "node_type": "work",
      "description": "Implementa a especificação em checkout isolado, com os testes de aceite escritos antes da implementação.",
      "skill_ref": {
        "id": "cartografo/desenvolver-ticket",
        "version": "1.0.0",
        "hash": "sha256:464be2db9d71760fee4b31933cf195fd9b581ec24ab4e0620c5a51cca865ed7e"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["ticket_id", "especificacao", "criterios_de_aceite"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "especificacao": { "type": "string", "minLength": 1 },
            "criterios_de_aceite": { "type": "array", "items": { "type": "string" } }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["branch", "commits"],
          "properties": {
            "branch": { "type": "string", "minLength": 1 },
            "commits": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "arquivos_inesperados": { "type": "array", "items": { "type": "string" } }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "make check",
            "description": "Suíte, lint e typecheck verdes no branch da ticket."
          },
          {
            "type": "agentic",
            "instruction": "Os testes de aceite foram commitados antes da implementação e cobrem os critérios da especificação? Anexe os hashes dos dois commits e o diff do commit de testes.",
            "required_evidence": true,
            "description": "Verifica a ordem do TDD pelo histórico, não pelo relato de quem desenvolveu."
          }
        ]
      }
    },
    {
      "id": "integrar",
      "role": "integrador",
      "node_type": "work",
      "description": "Traz o branch para a linha principal e reverifica a suíte contra a árvore já integrada.",
      "skill_ref": {
        "id": "cartografo/integrar-branch",
        "version": "1.0.0",
        "hash": "sha256:a12bea4cd570a45bf0667cdb76bd8c57c8bc949165a30c2e2581472df2030109"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["ticket_id", "branch"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "branch": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["merge_commit"],
          "properties": {
            "merge_commit": { "type": "string", "minLength": 1 },
            "conflitos_resolvidos": { "type": "array", "items": { "type": "string" } }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "make check",
            "description": "A suíte passa na árvore mesclada, não só no branch isolado."
          }
        ]
      }
    },
    {
      "id": "testar",
      "role": "tester",
      "node_type": "gate",
      "description": "Exercita o comportamento entregue contra os critérios de aceite e roteia: aprovado segue para implantação, retrabalho volta para desenvolvimento.",
      "skill_ref": {
        "id": "cartografo/testar-alpha",
        "version": "1.0.0",
        "hash": "sha256:5f5184ed32383ec586147bddb5d5aaa1554104efa071ac2fd183d4f0ae87e81c"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["ticket_id", "criterios_de_aceite", "merge_commit"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "criterios_de_aceite": { "type": "array", "items": { "type": "string" } },
            "merge_commit": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["outcome", "evidencia"],
          "properties": {
            "outcome": { "enum": ["aprovado", "retrabalho", "escala"] },
            "evidencia": { "type": "string", "minLength": 1 },
            "defeitos": { "type": "array", "items": { "type": "string" } }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "make check",
            "description": "Reverificação determinística antes de qualquer julgamento."
          },
          {
            "type": "agentic",
            "instruction": "Rode o comportamento entregue e confira cada critério de aceite na aplicação real. Anexe a saída de cada execução; relato do desenvolvedor não conta como evidência.",
            "required_evidence": true,
            "description": "Portão agêntico verifica com evidência própria (nota de aprendizado, 2026-08-14)."
          }
        ]
      }
    },
    {
      "id": "implantar",
      "role": "deployer",
      "node_type": "work",
      "description": "Publica o que foi aprovado e encerra a travessia.",
      "skill_ref": {
        "id": "cartografo/implantar-release",
        "version": "1.0.0",
        "hash": "sha256:2e4cddb5fdbb1b467d280800299c4150a17022b201eacf7baa56c76e78e01d94"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["ticket_id", "merge_commit"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "merge_commit": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["release", "implantado_em"],
          "properties": {
            "release": { "type": "string", "minLength": 1 },
            "implantado_em": { "type": "string" }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "make smoke",
            "description": "Smoke test contra o ambiente publicado."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "refinar",
      "to": "desenvolver",
      "condition": "sempre",
      "description": "flowpilot: refining -> to_develop -> developing."
    },
    {
      "from": "desenvolver",
      "to": "integrar",
      "condition": "sempre",
      "description": "flowpilot: developing -> to_integrate -> integrating."
    },
    {
      "from": "integrar",
      "to": "testar",
      "condition": "sempre",
      "description": "flowpilot: integrating -> to_test -> testing."
    },
    {
      "from": "testar",
      "to": "implantar",
      "condition": "aprovado",
      "description": "flowpilot: testing -> to_deploy -> deploying."
    },
    {
      "from": "testar",
      "to": "desenvolver",
      "condition": "retrabalho",
      "description": "flowpilot: testing -> to_develop, o ciclo de retrabalho do teste alfa."
    }
  ],
  "initial_node": "refinar",
  "final_nodes": ["implantar"]
}
