{
  "problem_class": "short-note-dangling-hook",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "Short note — a hook pointing at a node that does not exist",
    "description": "t169's counterexample: the workflow net is sound and the shape passes the JSON Schema, but a hook points at a node the document does not have. It is a referential-integrity defect, and that is why it comes out of the validator's STRUCTURAL pass, not from among the four soundness rules.",
    "schema_version": "1.0.0",
    "created_at": "2026-08-16",
    "source": "a manual port (the specification's example)"
  },
  "nodes": [
    {
      "id": "redigir",
      "role": "redator",
      "node_type": "work",
      "description": "Writes the note from the declared topic.",
      "skill_ref": {
        "id": "cartografo/redigir-nota",
        "version": "1.0.0",
        "hash": "sha256:2745f9d87a5b35e77dc5a73b8db71039cdfdae5a4c647f2f4122c1f3fb384b18"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "tema"
          ],
          "properties": {
            "tema": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "texto"
          ],
          "properties": {
            "texto": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s nota.md",
            "description": "The note exists and is not empty."
          }
        ]
      }
    },
    {
      "id": "revisar",
      "role": "revisor",
      "node_type": "gate",
      "description": "Checks the note against the declared topic and closes the traversal.",
      "skill_ref": {
        "id": "cartografo/revisar-nota",
        "version": "1.0.0",
        "hash": "sha256:2df09e19d5917210efc074a4d3c9d5f4c8e20e29e479f524afdcbbc9859b3e55"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": [
            "tema",
            "texto"
          ],
          "properties": {
            "tema": {
              "type": "string"
            },
            "texto": {
              "type": "string"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "outcome",
            "evidencia"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "passou",
                "falhou",
                "escala"
              ]
            },
            "evidencia": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "checks": [
          {
            "type": "agentic",
            "instruction": "Does the note answer the declared topic with no unsourced assertion? Cite the passage that supports the verdict.",
            "required_evidence": true,
            "description": "A judgement of adherence to the topic, with evidence of its own."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "redigir",
      "to": "revisar",
      "condition": "sempre",
      "description": "A single exit: the drafted note always goes on to review."
    }
  ],
  "initial_node": "redigir",
  "final_nodes": [
    "revisar"
  ],
  "custom_fields": [],
  "hooks": [
    {
      "id": "avisar-revisao",
      "trigger": "node_entered",
      "node_id": "no_que_nao_existe",
      "destination": {
        "type": "webhook",
        "url": "https://exemplo.invalid/ganchos/revisao",
        "secret_ref": "gancho-revisao"
      },
      "description": "It points at a node that does not exist: that is what the structural validator refuses."
    }
  ]
}
