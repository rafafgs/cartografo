{
  "problem_class": "short-note-with-hooks",
  "lineage": {
    "type": "base"
  },
  "metadata": {
    "name": "Short note — with transition hooks",
    "description": "The minimal graph with the two reactions the format knows: notify when the job enters review, and notify when it stalls in drafting. A hook is data of the document, so it is born versioned with the graph and changes by proposal like any other part of it.",
    "schema_version": "1.0.0",
    "created_at": "2026-08-16",
    "source": "a manual port (the specification's example)"
  },
  "nodes": [
    {
      "id": "redigir",
      "role": "redator",
      "node_type": "work",
      "description": "Writes the note from the declared topic.",
      "skill_ref": {
        "id": "cartografo/redigir-nota",
        "version": "1.0.0",
        "hash": "sha256:2745f9d87a5b35e77dc5a73b8db71039cdfdae5a4c647f2f4122c1f3fb384b18"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["tema"],
          "properties": {
            "tema": { "type": "string", "minLength": 1 }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["texto"],
          "properties": {
            "texto": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "deterministic",
            "command": "test -s nota.md",
            "description": "The note exists and is not empty."
          }
        ]
      }
    },
    {
      "id": "revisar",
      "role": "revisor",
      "node_type": "gate",
      "description": "Checks the note against the declared topic and closes the traversal.",
      "skill_ref": {
        "id": "cartografo/revisar-nota",
        "version": "1.0.0",
        "hash": "sha256:2df09e19d5917210efc074a4d3c9d5f4c8e20e29e479f524afdcbbc9859b3e55"
      },
      "contract": {
        "input_schema": {
          "type": "object",
          "required": ["tema", "texto"],
          "properties": {
            "tema": { "type": "string" },
            "texto": { "type": "string" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["outcome", "evidencia"],
          "properties": {
            "outcome": { "enum": ["passou", "falhou", "escala"] },
            "evidencia": { "type": "string", "minLength": 1 }
          }
        },
        "checks": [
          {
            "type": "agentic",
            "instruction": "Does the note answer the declared topic with no unsourced assertion? Cite the passage that supports the verdict.",
            "required_evidence": true,
            "description": "A judgement of adherence to the topic, with evidence of its own."
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "redigir",
      "to": "revisar",
      "condition": "sempre",
      "description": "A single exit: the drafted note always goes on to review."
    }
  ],
  "initial_node": "redigir",
  "final_nodes": ["revisar"],
  "custom_fields": [],
  "hooks": [
    {
      "id": "avisar-revisao",
      "trigger": "node_entered",
      "node_id": "revisar",
      "destination": {
        "type": "webhook",
        "url": "https://exemplo.invalid/ganchos/revisao",
        "secret_ref": "gancho-revisao"
      },
      "description": "Notifies the on-duty reviewer when a note arrives for review."
    },
    {
      "id": "avisar-bloqueio",
      "trigger": "node_blocked",
      "node_id": "redigir",
      "destination": {
        "type": "webhook",
        "url": "https://exemplo.invalid/ganchos/bloqueio",
        "secret_ref": "gancho-bloqueio"
      },
      "description": "Notifies when drafting stalls, which is where this graph usually stops."
    }
  ]
}
