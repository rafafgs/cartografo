{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph_version.applied.schema.json",
  "title": "graph_version.applied",
  "description": "The graph's current-version pointer came to point at this version (D15). entity.id is the hash of the version that came to hold. A cartografo extension, with no flowpilot equivalent.",
  "type": "object",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "graph_version.applied"
    },
    "entity": {
      "type": "object",
      "properties": {
        "type": {
          "const": "graph_version"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "graph_id"
      ],
      "properties": {
        "graph_id": {
          "type": "string",
          "description": "The graph whose pointer moved."
        },
        "proposal_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The proposal whose application moved the pointer, when there was one."
        }
      },
      "additionalProperties": false
    }
  }
}
