{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // The packages run TypeScript directly (tsx / type stripping), with no emit
    // step. That is why the relative imports cite the real `.ts` file: it is what
    // the loader resolves at run time, and `allowImportingTsExtensions` (which
    // demands `noEmit`) is what makes the compiler accept the same spelling.
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "types": ["node"]
  }
}
